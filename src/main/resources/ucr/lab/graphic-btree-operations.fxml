                <Button layoutY="12.0" mnemonicParsing="false" onAction="#randomizeOnAction" prefHeight="32.0" prefWidth="112.0" text="Randomize">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="118.0" layoutY="12.0" mnemonicParsing="false" onAction="#containsOnAction" prefHeight="32.0" prefWidth="99.0" text="Contains">
                    <font>
                        <Font size="15.0" />
                    </font>
                </Button>
                <Button layoutX="223.0" layoutY="12.0" mnemonicParsing="false" onAction="#addOnAction" prefHeight="32.0" prefWidth="79.0" text="Add ">
