            <children>
                <Label layoutX="158.0" layoutY="14.0" text="Graphic Binary Tree - Operations">
                    <font>
                        <Font name="System Bold" size="25.0" />
                    </font>
                </Label>
            </children>
        </Pane>
    </top>

    <center>
        <Pane prefHeight="75.0" prefWidth="695.0" style="-fx-background-color: #7AC3A1;" BorderPane.alignment="CENTER">
