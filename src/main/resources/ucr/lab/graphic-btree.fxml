<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GraphicBtreeController">

    <top>
        <Pane prefHeight="64.0" prefWidth="600.0" style="-fx-background-color: #E95420;" BorderPane.alignment="CENTER">
            <children>
                <Label layoutX="234.0" layoutY="14.0" text="Graphic Binary Tree">
                    <font>
                        <Font name="System Bold" size="25.0" />
                    </font>
                </Label>
            </children>
        </Pane>
    </top>

    <center>
        <Pane prefHeight="112.0" prefWidth="700.0" style="-fx-background-color: #7AC3A1;" BorderPane.alignment="CENTER">
            <children>
                <Button layoutX="52.0" layoutY="27.0" mnemonicParsing="false" onAction="#randomizeOnAction" prefHeight="31.0" prefWidth="142.0" text="Randomize">
                    <font>
                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>
                <Button layoutX="293.0" layoutY="27.0" mnemonicParsing="false" onAction="#levelsOnAction" prefHeight="31.0" prefWidth="142.0" text="Levels">
