                        <Font name="System Bold" size="15.0" />
                    </font>
                </Button>
                <Button layoutX="503.0" layoutY="27.0" mnemonicParsing="false" onAction="#tourInfoOnAction" prefHeight="31.0" prefWidth="142.0" text="Tour Info">
